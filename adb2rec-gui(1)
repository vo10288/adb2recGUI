def compressandhash():
    """Start file hashing and compression"""
    def compress_and_hash_worker():
        os.chdir(forensic_tool.base_directory)
        
        print("Starting compression and hash calculation...")
        
        # Compress screenshot
        print("Compressing screenshots...")
        success, _, _ = forensic_tool.run_adb_command(
            'tar -czf compressfiles/screenshot.tar.gz screenshot/'
        )
        if not success:
            print("Failed to compress screenshots")
            return
        
        # Compress screenrecord
        print("Compressing screen recordings...")
        success, _, _ = forensic_tool.run_adb_command(
            'tar -czf compressfiles/screenrecord.tar.gz screenrecord/'
        )
        if not success:
            print("Failed to compress screen recordings")
            return
        
        # Compress repaired videos if they exist
        if exists(join(forensic_tool.base_directory, "repaired_videos")):
            print("Compressing repaired videos...")
            forensic_tool.run_adb_command(
                'tar -czf compressfiles/repaired_videos.tar.gz repaired_videos/'
            )
        
        print("Compression completed. Calculating hashes...")
        
        # Files hashing for screenshots
        print("Calculating hashes for screenshots...")
        forensic_tool.run_adb_command(
            'md5sum compressfiles/screenshot.tar.gz >> hashfiles/hash_screenshot.txt'
        )
        forensic_tool.run_adb_command(
            'sha256sum compressfiles/screenshot.tar.gz >> hashfiles/hash_screenshot.txt'
        )
        
        # Files hashing for screenrecord
        print("Calculating hashes for screen recordings...")
        forensic_tool.run_adb_command(
            'md5sum compressfiles/screenrecord.tar.gz >> hashfiles/hash_screenrecord.txt'
        )
        forensic_tool.run_adb_command(
            'sha256sum compressfiles/screenrecord.tar.gz >> hashfiles/hash_screenrecord.txt'
        )
        
        # Hash repaired videos if they exist
        if isfile(join(forensic_tool.base_directory, "compressfiles/repaired_videos.tar.gz")):
            print("Calculating hashes for repaired videos...")
            forensic_tool.run_adb_command(
                'md5sum compressfiles/repaired_videos.tar.gz >> hashfiles/hash_repaired_videos.txt'
            )
            forensic_tool.run_adb_command(
                'sha256sum compressfiles/repaired_videos.tar.gz >> hashfiles/hash_repaired_videos.txt'
            )
        
        # Get Android ID and organize files
        success, android_id, _ = forensic_tool.run_adb_command(
            "adb shell settings get secure android_id"
        )
        if success and android_id.strip():
            android_id = android_id.strip()
            android_dir = join(forensic_tool.base_directory, android_id)
            
            if not exists(android_dir):
                makedirs(android_dir)
            
            # Move all the files in the device directory
            commands = [
                f"mv compressfiles/* '{android_dir}/' 2>/dev/null",
                f"mv hashfiles/* '{android_dir}/' 2>/dev/null",
                f"mv screenshot/ '{android_dir}/' 2>/dev/null",
                f"mv screenrecord/ '{android_dir}/' 2>/dev/null",
                f"mv repaired_videos/ '{android_dir}/' 2>/dev/null",
                f"mv temp*.png '{android_dir}/' 2>/dev/null"
            ]
            
            for cmd in commands:
                subprocess.run(cmd, shell=True)
            
            print(f"All files organized in directory: {android_dir}")
            messagebox.showinfo("Success", f"Compression and hash calculation completed!\nFiles saved in: {android_dir}")
        else:
            messagebox.showinfo("Success", "Compression and hash calculation completed!")
    
    # Start new thread to preserve the GUI running
    compress_thread = threading.Thread(target=compress_and_hash_worker)
    compress_thread.daemon = True
    compress_thread.start()

