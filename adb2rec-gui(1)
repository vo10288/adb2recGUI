class VideoRepairTool:
    """Function to fix any potential corruped videos by ADB screenrecord"""
    
    @staticmethod
    def repair_single_video(video_path, output_path=None):
        """Fix a single video using FFmpeg"""
        try:
            path_obj = Path(video_path)
            if output_path is None:
                output_path = path_obj.parent / f"{path_obj.stem}_fixed{path_obj.suffix}"
            
            cmd = [
                'ffmpeg', '-hide_banner', '-loglevel', 'error',
                '-fflags', '+discardcorrupt+genpts+fastseek',
                '-flags', '+global_header',
                '-i', str(video_path),
                '-map', '0:v:0', '-map', '0:a?',
                '-c:a', 'aac', '-b:a', '192k',
                '-c:v', 'libx264',
                '-preset', 'fast',
                '-crf', '23',
                '-movflags', '+faststart',
                '-avoid_negative_ts', 'make_zero',
                '-pix_fmt', 'yuv420p',
                '-y', str(output_path)
            ]
            
            result = subprocess.run(cmd, capture_output=True, text=True)
            
            if result.returncode == 0 and Path(output_path).exists():
                if Path(output_path).stat().st_size > 1024:  # Valid file
                    return True, str(output_path)
                else:
                    Path(output_path).unlink(missing_ok=True)
                    return False, "Empty fixed file"
            else:
                return False, result.stderr
                
        except Exception as e:
            return False, str(e)
    
    @staticmethod
    def optimize_for_ocr(video_path, output_path=None):
        """Video enhancement for OCR analysis"""
        try:
            path_obj = Path(video_path)
            if output_path is None:
                output_path = path_obj.parent / f"{path_obj.stem}_ocr{path_obj.suffix}"
            
            cmd = [
                'ffmpeg', '-hide_banner', '-loglevel', 'error',
                '-i', str(video_path),
                '-vf', 'scale=-2:720',  # resize keeping aspect ratio
                '-map', '0:v:0', '-map', '0:a?',
                '-c:a', 'aac', '-b:a', '192k',
                '-c:v', 'libx264',
                '-preset', 'medium',
                '-crf', '18',  # high quality for OCR
                '-pix_fmt', 'yuv420p',
                '-r', '10',  # reduce fps for OCR
                '-movflags', '+faststart',
                '-y', str(output_path)
            ]
            
            result = subprocess.run(cmd, capture_output=True, text=True)
            
            if result.returncode == 0:
                return True, str(output_path)
            else:
                return False, result.stderr
                
        except Exception as e:
            return False, str(e)

class AdbMobileForensic:
    def __init__(self):
        self.base_directory = expanduser("~/02.computer_vision/04.video2ocr")
        self.setup_directories()
        self.current_screenshot_dir = None
        self.current_screenrecord_dir = None
        self.video_repair_tool = VideoRepairTool()
        
    def setup_directories(self):
        """Create the directories if not presents"""
        directories = ['screenshot', 'screenrecord', 'compressfiles', 'hashfiles', 'repaired_videos']
        for dir_name in directories:
            dir_path = join(self.base_directory, dir_name)
            if not exists(dir_path):
                makedirs(dir_path)
                
    def get_timestamp(self):
        """Get timestamp in the following format YYYYMMDDHHMMss"""
        return datetime.now().strftime("%Y%m%d%H%M%S")
    
    def run_adb_command(self, command):
        """Execute adb command and returns the result"""
        try:
            result = subprocess.run(command, shell=True, capture_output=True, text=True)
            return result.returncode == 0, result.stdout, result.stderr
        except Exception as e:
            return False, "", str(e)
    
    def is_device_connected(self):
        """Verify if and Android device is connected"""
        success, stdout, _ = self.run_adb_command("adb devices -l")
        if success and ("device usb" in stdout or "device product" in stdout):
            return True
        return False
    
    def screenshot_worker(self, mode=None):
        """Worker thread for the screenshots"""
        timestamp = self.get_timestamp()
        self.current_screenshot_dir = join(self.base_directory, "screenshot", timestamp)
        makedirs(self.current_screenshot_dir)
        
        x = 1
        print(f"Screenshot started. Press 'Stop Screenshot' to quit")
        print(f"Working directory: {self.current_screenshot_dir}")
        
        while not stop_screenshot.is_set() and x < 1000000000:
            # Take screenshot
            screenshot_path = join(self.current_screenshot_dir, f"{x}.png")
            success, _, _ = self.run_adb_command(f"adb exec-out screencap -p > '{screenshot_path}'")
            
            if success:
                print(f"Screenshot saved: {screenshot_path}")
                
                # Manage swipe if requested
                if mode == 'up':
                    self.run_adb_command("adb shell input touchscreen swipe 300 300 500 1000")
                elif mode == 'down':
                    self.run_adb_command("adb shell input touchscreen swipe 500 800 300 300")
                
                # Copy temporary files
                temp_path = join(self.base_directory, "temp.png")
                temp1_path = join(self.base_directory, "temp1.png")
                subprocess.run(f"cp '{screenshot_path}' '{temp_path}'", shell=True)
                subprocess.run(f"cp '{temp_path}' '{temp1_path}'", shell=True)
            else:
                print(f"Failed to capture screenshot {x}")
            
            x += 1
            time.sleep(0.1)  # Small pause between each screenshot
        
        print("Screenshot stopped")
    
    def get_scrcpy_binary(self):
        """Prefer the configured or portable scrcpy over the old system package."""
        configured = os.environ.get("SCRCPY_BINARY")
        if configured:
            candidate = shutil.which(expanduser(configured))
            if not candidate:
                raise RuntimeError("SCRCPY_BINARY does not point to an executable")
            return candidate
        candidates = sorted(
            Path(expanduser("~")).glob("scrcpy-linux-x86_64-v*/scrcpy"),
            key=lambda p: p.stat().st_mtime, reverse=True
        )
        for candidate in candidates:
            if os.access(candidate, os.X_OK):
                return str(candidate.resolve())
        candidate = shutil.which("scrcpy")
        if not candidate:
            raise RuntimeError("scrcpy not found. Set SCRCPY_BINARY to the new executable.")
        return candidate

    def screenrecord_worker(self):
        """Record video and internal audio in 180-second segments, then repair."""
        try:
            scrcpy_binary = self.get_scrcpy_binary()
            check = subprocess.run([scrcpy_binary, "--help"], capture_output=True,
                                   text=True, timeout=10)
            required = ("--require-audio", "--time-limit")
            if check.returncode or any(flag not in check.stdout for flag in required):
                raise RuntimeError("scrcpy is too old. Set SCRCPY_BINARY to the updated version.")
        except Exception as e:
            print(f"Cannot start audio/video recording: {e}")
            return

        timestamp = self.get_timestamp()
        self.current_screenrecord_dir = join(self.base_directory, "screenrecord", timestamp)
        makedirs(self.current_screenrecord_dir)
        x = 1
        print("Screen and INTERNAL AUDIO recording started. Press 'Stop Screen Record' to quit")
        print(f"Working directory: {self.current_screenrecord_dir}")
        print(f"Using scrcpy: {scrcpy_binary}")

        while not stop_screenrecord.is_set() and x < 1000000000:
            temp_local_path = join(self.current_screenrecord_dir, f"temp_{x}.mp4")
            final_local_path = join(self.current_screenrecord_dir, f"{x}.mp4")
            record_command = [
                scrcpy_binary, "--record=" + temp_local_path,
                "--video-bit-rate=4M", "--video-codec=h264",
                "--audio-source=output", "--audio-codec=aac", "--require-audio",
                "--time-limit=180", "--no-control"
            ]
            print(f"Starting recording {x} (video + internal audio)...")
            record_process = None
            try:
                # A log file avoids undrained PIPEs and retains scrcpy diagnostics.
                log_path = join(self.current_screenrecord_dir, f"scrcpy_{x}.log")
                with open(log_path, "w", encoding="utf-8") as log_file:
                    record_process = subprocess.Popen(
                        record_command, stdout=log_file, stderr=subprocess.STDOUT
                    )
                    try:
                        while record_process.poll() is None:
                            if stop_screenrecord.wait(0.2):
                                print("Stop requested, finalizing recording...")
                                break
                    finally:
                        if record_process.poll() is None:
                            record_process.send_signal(signal.SIGINT)
                            try:
                                record_process.wait(timeout=15)
                            except subprocess.TimeoutExpired:
                                record_process.terminate()
                                try:
                                    record_process.wait(timeout=5)
                                except subprocess.TimeoutExpired:
                                    record_process.kill()
                                    record_process.wait()
                success = (record_process.returncode == 0 and isfile(temp_local_path)
                           and os.path.getsize(temp_local_path) > 1024)
                stderr = f"scrcpy exit code {record_process.returncode}; see {log_path}"
            except Exception as e:
                success, stderr = False, str(e)

            if success and isfile(temp_local_path):
                # Fix video with FFmpeg
                print(f"Repairing video {x}...")
                repair_success, repair_result = self.video_repair_tool.repair_single_video(
                    temp_local_path, final_local_path
                )
                
                if repair_success:
                    print(f"✅ Video {x} recorded and repaired: {final_local_path}")
                    # Delete temporary file
                    try:
                        remove(temp_local_path)
                    except:
                        pass
                else:
                    print(f"⚠️ Video repairing failed for {x}: {repair_result}")
                    print(f"   Keep original: {temp_local_path}")
                    try:
                        rename(temp_local_path, final_local_path)
                    except:
                        pass
                
            else:
                print(f"❌ Failed to record video {x}: {stderr}")
                print("Any partial file is retained. Recording stopped.")
                break
            
            if stop_screenrecord.is_set():
                break
            
            x += 1
        
        print("Screen recording stopped")
    
    def repair_existing_videos(self):
        """Repair all the existent videosin the screenrecord directory"""
        def repair_worker():
            print("🔧 Start repairing existent videos...")
            
            # Fin all mp4 videos in the screenrecord directory
            pattern = join(self.base_directory, "screenrecord", "**/*.mp4")
            video_files = glob.glob(pattern, recursive=True)
            
            if not video_files:
                messagebox.showinfo("Info", "No MP4 videos found to repair")
                return
            
            print(f"Found {len(video_files)} video to repair")
            
            repaired_count = 0
            repair_dir = join(self.base_directory, "repaired_videos", self.get_timestamp())
            makedirs(repair_dir)
            
            for i, video_file in enumerate(video_files, 1):
                print(f"📹 Video repairing {i}/{len(video_files)}: {video_file}")
                
                # File name repaired
                video_name = Path(video_file).name
                repaired_path = join(repair_dir, f"repaired_{video_name}")
                
                # Repair video
                success, result = self.video_repair_tool.repair_single_video(video_file, repaired_path)
                
                if success:
                    print(f"✅ Repaired: {repaired_path}")
                    repaired_count += 1
                    
                    # Optimize for OCR if requested
                    ocr_path = join(repair_dir, f"ocr_{video_name}")
                    ocr_success, ocr_result = self.video_repair_tool.optimize_for_ocr(repaired_path, ocr_path)
                    
                    if ocr_success:
                        print(f"📊 Optimized for OCR: {ocr_path}")
                else:
                    print(f"❌ Repairing error: {result}")
            
            message = f"Repair completed!\n\n"
            message += f"Repaired videos: {repaired_count}/{len(video_files)}\n"
            message += f"Directory output: {repair_dir}"
            
            messagebox.showinfo("Repair completed", message)
            print(f"🎉 Repair completed: {repaired_count}/{len(video_files)} repaired videos")
        
        # Start thread to avoid blocking the GUI
        repair_thread = threading.Thread(target=repair_worker)
        repair_thread.daemon = True
        repair_thread.start()

