def adb_connect_ip_wifi():
    """Device connection using WiFi"""
    print("You have chosen ADB Connect wifi, please wait...")
    print("Now connect the Mobile Phone to the wifi network and get the IP address")
    
    # Create window to get IP address information
    dialog = tk.Toplevel()
    dialog.title("Enter IP Address")
    dialog.geometry("350x150")
    dialog.transient()
    dialog.grab_set()
    
    tk.Label(dialog, text="Enter device IP (e.g., 192.168.1.100):").pack(pady=10)
    ip_entry = tk.Entry(dialog, width=20, font=("Arial", 12))
    ip_entry.pack(pady=5)
    ip_entry.focus()
    
    def connect_ip():
        ip = ip_entry.get().strip()
        if not ip:
            messagebox.showerror("Error", "Please enter an IP address")
            return
            
        try:
            socket.inet_aton(ip)
            print(f"Valid IP: {ip}")
            success, stdout, stderr = forensic_tool.run_adb_command(f"adb connect {ip}:7777")
            if success:
                print(f"Connected to {ip}:7777")
                messagebox.showinfo("Success", f"Connected to {ip}:7777")
                dialog.destroy()
            else:
                messagebox.showerror("Error", f"Failed to connect to {ip}:7777\n{stderr}")
        except socket.error:
            messagebox.showerror("Error", "Invalid IP address format")
    
    button_frame = tk.Frame(dialog)
    button_frame.pack(pady=10)
    
    tk.Button(button_frame, text="Connect", command=connect_ip, bg="#1919EE", fg="white").pack(side=tk.LEFT, padx=5)
    tk.Button(button_frame, text="Cancel", command=dialog.destroy, bg="#888888", fg="white").pack(side=tk.LEFT, padx=5)
    
    # Bind Enter key
    ip_entry.bind('<Return>', lambda e: connect_ip())

